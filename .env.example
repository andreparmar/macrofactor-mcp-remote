# ─── MacroFactor auth — self-healing (two tiers) ────────────────────────────
# Tier 1 (always on): the Firebase refresh token rotates on every hourly refresh.
#   The server persists the latest to REFRESH_TOKEN_STORE (below) so it survives
#   container restarts — the reason the token used to go stale every few weeks.
# Tier 2 (optional, fully zero-touch): if a token is ever REVOKED, the server
#   re-logs-in with the credentials below to mint a brand-new one.

# Seed refresh token. Run: npm run get-refresh-token (needs the creds below locally).
# With Tier 2 creds set this is optional — the server can log in from scratch.
FIREBASE_REFRESH_TOKEN=

# Tier 2 auto-login credentials. Set BOTH to make the server fully self-healing.
# Leave blank to stay token-only (a full revoke would then need a manual paste).
MACROFACTOR_USERNAME=
MACROFACTOR_PASSWORD=

# Where the rotating refresh token is persisted. On Railway, point this inside an
# attached Volume so it survives restarts (default assumes a Volume mounted at /data).
REFRESH_TOKEN_STORE=/data/mf-refresh-token

# App Check is NOT required for the read endpoints this server uses (verified: reads
# work on the refresh token alone). Leave FIREBASE_APP_CHECK_TOKEN unset and no App
# Check header is sent. Only set it if MacroFactor ever starts enforcing App Check.
FIREBASE_APP_CHECK_TOKEN=

# Optional Discord webhook for server notices (start, manual App Check push)
DISCORD_WEBHOOK_URL=

# Firebase + Typesense keys (extract from MacroFactor app traffic or use known values)
FIREBASE_WEB_API_KEY=
TYPESENSE_HOST=
TYPESENSE_API_KEY=

# OAuth admin password — set something strong, this protects the MCP endpoint
OAUTH_ADMIN_PASSWORD=

# Public URL of this server (required for OAuth discovery to return correct URLs)
# On Railway this is typically: https://<service-name>.railway.app
BASE_URL=

# HTTP port (Railway sets this automatically)
PORT=3001
